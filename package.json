{
  "name": "js-game-zero",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run lint && bun test && bun run docs:check",
    "coverage:check": "bun scripts/check-coverage.ts",
    "dev:sandbox": "bun apps/sandbox/src/server.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jgz": "bun packages/cli/src/cli.ts",
    "lint": "bun run typecheck && bun run format:check",
    "package:check": "bun scripts/check-packages.ts",
    "release:pack": "bun scripts/release.ts",
    "test": "bun test packages apps scripts",
    "test:e2e": "playwright test",
    "thumbnails": "bun scripts/capture-thumbnails.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bun": "^1.3.6",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
