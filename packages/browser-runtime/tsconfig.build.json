{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@js-game-zero/core": ["packages/core/dist/index.d.ts"],
      "@js-game-zero/core/host": ["packages/core/dist/host.d.ts"],
      "@js-game-zero/core/node": ["packages/core/dist/node.d.ts"]
    },
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "test"]
}
