{
  "name": "@js-game-zero/browser-runtime",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "description": "Run zero-boilerplate js-game-zero games: set WIDTH and HEIGHT, write draw(), and the runtime does the rest. Includes a script-tag build.",
  "keywords": [
    "game",
    "gamedev",
    "canvas",
    "education",
    "beginner",
    "pygame-zero"
  ],
  "author": "Taha Rafiq",
  "homepage": "https://github.com/Leaf-Learning/js-game-zero#readme",
  "bugs": {
    "url": "https://github.com/Leaf-Learning/js-game-zero/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leaf-Learning/js-game-zero.git",
    "directory": "packages/browser-runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/browser/browser.js"
  ],
  "dependencies": {
    "@js-game-zero/core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./iife": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser/browser.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts browser-runtime",
    "test": "bun test"
  }
}
